rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ────────────────────────────────────────────────────────────────
    // HELPER FUNCTIONS
    // ────────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    // Pakai userId sebagai parameter (cocok dengan wildcard {userId})
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidMessage(text) {
      return text is string && text.size() <= 1000;
    }

    // ────────────────────────────────────────────────────────────────
    // KOLEKSI: users/{userId}
    // ────────────────────────────────────────────────────────────────
    match /users/{userId} {

      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || 
                    (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friendCount']));
      allow delete: if false;

      // Sub-koleksi: streaks
      match /streaks/{streakId} {
        allow read:  if isOwner(userId);
        allow write: if isOwner(userId);
      }

      // Sub-koleksi: achievements
      match /achievements/{achievementId} {
        allow read:  if isAuthenticated();
        allow write: if isOwner(userId);
      }

      // Sub-koleksi: friends
      match /friends/{friendId} {
        allow read:  if isOwner(userId);
        allow write: if isOwner(userId) || isOwner(friendId);
      }

      // Sub-koleksi: materials (progress belajar)
      match /materials/{materialId} {
        allow read:  if isOwner(userId);
        allow write: if isOwner(userId);
      }
    }

    // ────────────────────────────────────────────────────────────────
    // KOLEKSI: friendRequests/{requestId}
    // ────────────────────────────────────────────────────────────────
    match /friendRequests/{requestId} {

      allow read: if isAuthenticated()
                  && resource != null
                  && (resource.data.fromUid == request.auth.uid
                      || resource.data.toUid == request.auth.uid);

      allow create: if isAuthenticated()
                    && request.resource.data.fromUid == request.auth.uid
                    && request.resource.data.status == 'pending';

      allow update: if isAuthenticated()
                    && resource.data.toUid == request.auth.uid
                    && request.resource.data.status in ['accepted', 'rejected'];

      allow delete: if false;
    }

    // ────────────────────────────────────────────────────────────────
    // KOLEKSI: messages/{chatId}
    // ────────────────────────────────────────────────────────────────
    match /messages/{chatId} {

      allow read: if isAuthenticated()
                  && request.auth.uid in resource.data.participants;

      allow create: if isAuthenticated()
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants is list
                    && request.resource.data.participants.size() == 2;

      allow update: if isAuthenticated()
                    && request.auth.uid in resource.data.participants;
      allow delete: if false;

      // Sub-koleksi: chats (pesan individual)
      match /chats/{messageId} {
        allow read: if isAuthenticated()
                    && request.auth.uid in
                       get(/databases/$(database)/documents/messages/$(chatId)).data.participants;

        allow create: if isAuthenticated()
                      && request.auth.uid in
                         get(/databases/$(database)/documents/messages/$(chatId)).data.participants
                      && request.resource.data.senderUid == request.auth.uid
                      && isValidMessage(request.resource.data.text)
                      && request.resource.data.isRead == false;

        allow update: if isAuthenticated()
                      && request.auth.uid in
                         get(/databases/$(database)/documents/messages/$(chatId)).data.participants;

        allow delete: if false;
      }
    }

    // ────────────────────────────────────────────────────────────────
    // KOLEKSI: communityFeed/{feedId}
    // ────────────────────────────────────────────────────────────────
    match /communityFeed/{feedId} {
      allow read:   if isAuthenticated();
      allow create: if isAuthenticated()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 500;
      allow update: if false;
      allow delete: if false;
    }

  }
}
